<Window x:Class="MySocialPlus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MySocialPlus.App.ViewModels"
        Title="MySocial+" Height="820" Width="1240" MinWidth="760" MinHeight="480"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- A round picture of the author, or their first letter when there is none. -->
        <DataTemplate x:Key="Avatar" DataType="{x:Type vm:ItemVm}">
            <Grid Width="40" Height="40" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource AccentLight}" />
                <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse>
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Avatar, Converter={StaticResource ImageUrl}, ConverterParameter=80}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </DataTemplate>

        <!-- A comment or mention: name, time, words. -->
        <DataTemplate x:Key="CommentTemplate" DataType="{x:Type vm:ItemVm}">
            <Border Padding="8,6" Margin="0,4,0,0" CornerRadius="6" Background="{StaticResource Pane}">
                <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource NewBrush}" Margin="0,7,8,0" VerticalAlignment="Top"
                             Visibility="{Binding IsNew, Converter={StaticResource Show}}" ToolTip="New since you last looked" />
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding ActivityLine}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TimeText}" ToolTip="{Binding FullTime}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                            <Button Style="{StaticResource LinkButton}" Content="Reply on the network" Tag="{Binding Link}" Click="OpenLink_Click"
                                    Margin="12,0,0,0" FontSize="12" Visibility="{Binding Link, Converter={StaticResource ShowIfAny}}"
                                    ToolTip="Opens the reply in your web browser, where you can answer it. MySocial+ never posts for you." />
                        </WrapPanel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- A like, repost or follow: one short line. -->
        <DataTemplate x:Key="ActivityTemplate" DataType="{x:Type vm:ItemVm}">
            <DockPanel Margin="0,3,0,0">
                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource NewBrush}" Margin="0,0,8,0"
                         Visibility="{Binding IsNew, Converter={StaticResource Show}}" ToolTip="New since you last looked" />
                <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="{Binding Glyph}" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding TimeText}" ToolTip="{Binding FullTime}" Foreground="{StaticResource Muted}" DockPanel.Dock="Right" />
                <TextBlock Text="{Binding ActivityLine}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <!-- The body of a post. -->
        <DataTemplate x:Key="PostTemplate" DataType="{x:Type vm:ItemVm}">
            <StackPanel>
                <TextBlock Text="{Binding Context}" Foreground="{StaticResource Muted}" FontStyle="Italic" FontSize="12" Margin="52,0,0,4"
                           Visibility="{Binding Context, Converter={StaticResource ShowIfAny}}" />
                <DockPanel>
                    <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Avatar}" Margin="0,0,12,0" Focusable="False" />
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" ToolTip="{Binding FullTime}" Foreground="{StaticResource Muted}" />
                            <WrapPanel>
                                <TextBlock Text="{Binding Author}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Source}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                            </WrapPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="15"
                                   Visibility="{Binding HasText, Converter={StaticResource Show}}" />
                        <Image Source="{Binding Image, Converter={StaticResource ImageUrl}}" MaxHeight="300" MaxWidth="520"
                               HorizontalAlignment="Left" Stretch="Uniform" Margin="0,8,0,0"
                               Visibility="{Binding Image, Converter={StaticResource ShowIfAny}}" />
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0"
                                Visibility="{Binding Attachment, Converter={StaticResource ShowIfAny}}">
                            <TextBlock Text="{Binding Attachment}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                        </Border>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding Counts}" Foreground="{StaticResource Muted}" Margin="0,0,16,0"
                                       Visibility="{Binding Counts, Converter={StaticResource ShowIfAny}}" />
                            <Button Style="{StaticResource LinkButton}" Content="{Binding OpenText}" Tag="{Binding Link}" Click="OpenLink_Click"
                                    Visibility="{Binding Link, Converter={StaticResource ShowIfAny}}"
                                    ToolTip="Opens the post in your web browser, where you can reply, like or share it." />
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ThreadTemplate" DataType="{x:Type vm:ThreadVm}">
            <Border x:Name="card" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" HorizontalAlignment="Right" Style="{StaticResource Badge}" Margin="0,0,0,4"
                            Visibility="{Binding IsNew, Converter={StaticResource Show}}">
                        <TextBlock Text="{Binding NewText}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <ContentControl Content="{Binding Post}" ContentTemplate="{StaticResource PostTemplate}" Focusable="False"
                                        Visibility="{Binding HasPost, Converter={StaticResource Show}}" />
                        <ItemsControl ItemsSource="{Binding Activity}" Focusable="False" Margin="52,6,0,0"
                                      Visibility="{Binding HasActivity, Converter={StaticResource Show}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ItemVm}">
                                    <ContentControl Content="{Binding}" Focusable="False">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ActivityTemplate}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsComment}" Value="True">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource CommentTemplate}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{StaticResource NewBack}" />
                    <Setter TargetName="card" Property="BorderBrush" Value="#F5B98F" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="2" Background="White">
            <MenuItem Header="_File">
                <MenuItem Header="_What's new" Click="WhatsNew_Click" />
                <MenuItem Header="_Check for new posts now" InputGestureText="F5" Click="CheckNow_Click" />
                <MenuItem Header="_Open the data folder" Click="OpenDataFolder_Click"
                          ToolTip="Where your tree (tree.json) and the saved posts (items.db) are kept." />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Tree">
                <MenuItem Header="New _topic…" Click="NewTopic_Click" />
                <MenuItem Header="Add a _person…" Click="AddPerson_Click" />
                <MenuItem Header="Add an _account to this person…" Click="AddAccount_Click" />
                <Separator />
                <MenuItem Header="_Rename…" InputGestureText="F2" Click="Rename_Click" />
                <MenuItem Header="_Delete" InputGestureText="Del" Click="Delete_Click" />
            </MenuItem>
            <MenuItem Header="_Accounts">
                <MenuItem Header="_Bluesky sign-in…" Click="BlueskySignIn_Click" />
                <MenuItem Header="_Choose people I follow on Bluesky…" Click="ImportFollows_Click" />
            </MenuItem>
            <MenuItem Header="T_ools">
                <MenuItem Header="_AI Settings…" Click="AiSettings_Click"
                          ToolTip="The AI keys MySocial+ will use. Nothing in MySocial+ uses the AI yet." />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Getting started" Click="GettingStarted_Click" />
                <MenuItem Header="_About MySocial+" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Pane}" Padding="10,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Check now" Click="CheckNow_Click" Padding="10,2" MinHeight="24"
                        ToolTip="Read every account now instead of waiting for the next check (F5)." />
                <TextBlock x:Name="NextCheckText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Left: the tree. -->
            <DockPanel Background="{StaticResource Pane}">
                <Button DockPanel.Dock="Top" Content="What's new" Click="WhatsNew_Click" HorizontalAlignment="Left" Margin="12,10,12,0"
                        ToolTip="Everything with something new, without marking any of it seen." />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="12,8,12,6"
                           Text="A number means something new since you last opened that node. Opening it marks it seen." />
                <WrapPanel DockPanel.Dock="Bottom" Margin="8">
                    <Button Content="New topic" Click="NewTopic_Click" Margin="0,0,6,6" ToolTip="Make a topic under My Friends, like Family or Colleagues." />
                    <Button Content="Add person" Click="AddPerson_Click" Margin="0,0,6,6" ToolTip="Add someone to the selected topic, with their account on a network." />
                </WrapPanel>
                <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" Padding="4"
                          SelectedItemChanged="Tree_SelectedItemChanged" KeyDown="Tree_KeyDown"
                          AllowDrop="True" PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown" PreviewMouseMove="Tree_PreviewMouseMove"
                          DragOver="Tree_DragOver" Drop="Tree_Drop" ContextMenuOpening="Tree_ContextMenuOpening"
                          AutomationProperties.Name="Your tree">
                    <TreeView.Resources>
                        <!-- A light selection, so the grey handle under a name stays readable. -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D3E3F6" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E3EAF2" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black" />
                    </TreeView.Resources>
                    <TreeView.ContextMenu>
                        <ContextMenu />
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}" />
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            <Setter Property="Padding" Value="2,3" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProfileOnly}" Value="True">
                                    <Setter Property="Opacity" Value="0.72" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:NodeVm}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Glyph}" Width="20" VerticalAlignment="Center"
                                           Foreground="{StaticResource Accent}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}"
                                               Visibility="{Binding Detail, Converter={StaticResource ShowIfAny}}" />
                                </StackPanel>
                                <Border Style="{StaticResource Badge}" Visibility="{Binding HasBadge, Converter={StaticResource Show}}">
                                    <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Line}" Focusable="False" />

            <!-- Right: the content of the selected node, or the welcome. -->
            <Grid Grid.Column="2">
                <ScrollViewer x:Name="Welcome" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="32,24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="Welcome to MySocial+" />
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontSize="15"
                                   Text="Your social media in your order, not an algorithm's. On the left is your tree. My Posts holds your own accounts: open one to see who replied to, liked or shared what you posted. My Friends holds the people you follow, in topics you make, like Family or Colleagues. Everything is in time order, newest first." />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="A number on a node is how much is new since you last opened it. Opening a node marks what is in it as seen. MySocial+ checks for new posts every 15 minutes while it is open." />

                        <TextBlock Text="Three steps to start" FontWeight="SemiBold" FontSize="16" Margin="0,24,0,8" />
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <DockPanel>
                                <Button x:Name="WelcomeConnect" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Connect Bluesky…" Click="BlueskySignIn_Click" VerticalAlignment="Center" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="1. Connect your Bluesky account" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WelcomeConnectHint" Style="{StaticResource Hint}"
                                               Text="You make an app password in Bluesky and paste it here. MySocial+ never sees your real password, and the app password stays on this computer." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <DockPanel>
                                <Button x:Name="WelcomeImport" DockPanel.Dock="Right" Content="Choose people…" Click="ImportFollows_Click" VerticalAlignment="Center" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="2. Bring in the people you follow" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Pick the people you care about from everyone you follow on Bluesky, and the topic each goes in. You can also add someone by hand with Add person." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="New topic…" Click="NewTopic_Click" VerticalAlignment="Center" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="3. Sort people into topics" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Make topics under My Friends, then drag a person onto a topic to move them. Right-click anything in the tree for more." />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="About Facebook" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,6" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Facebook comes next. It will show the comments on your own Facebook posts, though Facebook usually hides who wrote them. Facebook does not let any program read your friends' posts, so a friend's Facebook account opens their profile inside MySocial+ instead, without a number." />
                    </StackPanel>
                </ScrollViewer>

                <DockPanel x:Name="ContentArea">
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14,20,10">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel x:Name="SortPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Order:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Muted}" />
                                    <ComboBox x:Name="SortBox" Width="190" SelectionChanged="SortBox_SelectionChanged"
                                              AutomationProperties.Name="Order"
                                              ToolTip="Newest first: the latest at the top. Oldest unread first: catch up in the order things happened. Remembered for each node.">
                                        <ComboBoxItem Content="Newest first" />
                                        <ComboBoxItem Content="Oldest unread first" />
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock x:Name="ContentTitle" Style="{StaticResource H1}" />
                            </DockPanel>
                            <TextBlock x:Name="ContentSubtitle" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                            <ItemsControl x:Name="Notices" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource WarnBack}" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Tag="{Binding}" Click="Notice_Click" Margin="12,0,0,0"
                                                        VerticalAlignment="Center" Visibility="{Binding ActionText, Converter={StaticResource ShowIfAny}}" />
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource Warn}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" FontSize="15" Margin="24" MaxWidth="560"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <!-- What's new: where the window opens. Nothing is marked seen until Ron opens a node. -->
                        <ScrollViewer x:Name="Overview" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <ItemsControl x:Name="OverviewList" Margin="20,12" MaxWidth="640" HorizontalAlignment="Left" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NodeVm}">
                                        <Button Click="OverviewRow_Click" Tag="{Binding}" Margin="0,0,0,6" Padding="12,8"
                                                HorizontalContentAlignment="Stretch" Background="White" BorderBrush="{StaticResource Line}"
                                                AutomationProperties.Name="{Binding SpokenName}">
                                            <DockPanel MinWidth="420">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                                                    <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Glyph}" Foreground="{StaticResource Accent}"
                                                           Width="24" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <ListBox x:Name="ThreadList" BorderThickness="0" Padding="16,12" Background="#FAFBFC"
                                 ItemTemplate="{StaticResource ThreadTemplate}" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 AutomationProperties.Name="Posts">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding SpokenText}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="b" BorderThickness="2" BorderBrush="Transparent" CornerRadius="10" MaxWidth="820" HorizontalAlignment="Stretch">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
